+/* OpenWrt fw4 provides a timeout set dedicated to local STUN sockets.
+ * A timeout also closes the hole after a crash or forced termination. */
+#ifdef USE_NFTABLES
+static int
+stun_nft_element(const char *address, unsigned short port, int add)
+{
+	struct in_addr addr;
+	char element[96];
+	pid_t pid, result;
+	int status;
+
+	if (!address || inet_pton(AF_INET, address, &addr) != 1)
+		return -1;
+	snprintf(element, sizeof(element), add ? "{ %s . %hu timeout 60s }" :
+	         "{ %s . %hu }", address, port);
+	pid = fork();
+	if (pid < 0)
+		return -1;
+	if (pid == 0) {
+		execl("/usr/sbin/nft", "nft", add ? "add" : "delete", "element",
+		      "inet", "fw4", "upnp_stun_ports", element, (char *)NULL);
+		_exit(127);
+	}
+	do { result = waitpid(pid, &status, 0); } while (result < 0 && errno == EINTR);
+	if (result < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		syslog(LOG_ERR, "STUN: failed to %s temporary input port %hu",
+		       add ? "add" : "delete", port);
+		return -1;
+	}
+	return 0;
+}
+#endif
