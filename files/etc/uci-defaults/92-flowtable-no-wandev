#!/bin/sh
# Remove the physical WAN device from fw4's flowtable. PPPoE uplinks only.
#
# fw4 puts every device of the wan zone into the flowtable, including the
# physical NIC under pppoe-wan. With it there, a downstream packet is taken by
# the offload fast path at the physical device's ingress hook, has its PPPoE
# header popped and is forwarded to br-lan without the pppoe-wan netdev ever
# being traversed -- and qosify's ingress classifier and mirred redirect live
# on that netdev's clsact, so ingress shaping silently does nothing.
#
# Without it, downstream goes physical device -> stack PPPoE decap ->
# pppoe-wan's tc ingress (shaping happens here) -> pppoe-wan's flowtable hook
# (routing/NAT still offloaded). Egress is unaffected either way: it uses
# pppoe-wan's root qdisc.
#
# A DHCP/static uplink has no physical-plus-dialer pair -- the WAN is the
# physical device -- so removing it would disable WAN-direction offload
# altogether. Register nothing there, and clear any include section and
# snippet left over from an earlier configuration.
#
# The snippet is generated here rather than shipped because the device name is
# only known at runtime. That is safe because uci-defaults rerun on every
# flash: the include section lives in /etc/config/firewall and survives
# sysupgrade while the file under /usr/share does not, and a dangling path
# makes fw4 refuse to load the entire ruleset.
SNIP=/usr/share/fw4-extra/flowtable-no-wandev.nft

proto="$(uci -q get network.wan.proto)"
dev="$(uci -q get network.wan.device)"

if [ "$proto" != pppoe ] || [ -z "$dev" ]; then
	rm -f "$SNIP"
	[ -n "$(uci -q get firewall.ftnowandev)" ] && {
		uci -q delete firewall.ftnowandev
		uci commit firewall
	}
	exit 0
fi

mkdir -p "$(dirname "$SNIP")"
cat > "$SNIP" <<SNIPEOF
# Generated by /etc/uci-defaults/92-flowtable-no-wandev; rewritten on every
# flash, so do not edit. Device name comes from network.wan.device (PPPoE).
delete flowtable inet fw4 ft { hook ingress priority filter; devices = { $dev }; }
SNIPEOF

# position must be ruleset-append (fw4 normalises postpend to it): table-* and
# chain-* splice the text inside the table, where a top-level delete flowtable
# is a syntax error and fw4 refuses the whole ruleset. The file must also stay
# out of /etc/nftables.d/, which is auto-scanned into the table and fails the
# same way -- and there, removing the include section does not fix it.
[ "$(uci -q get firewall.ftnowandev.path)" = "$SNIP" ] && exit 0
uci set firewall.ftnowandev=include
uci set firewall.ftnowandev.type=nftables
uci set firewall.ftnowandev.path="$SNIP"
uci set firewall.ftnowandev.position=ruleset-append
uci commit firewall
exit 0
