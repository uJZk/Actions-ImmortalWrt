#!/bin/sh
# Factory defaults for the settings this repo has validated as generally
# applicable. Deliberately left alone: bandwidth (qosify's rate limits, the
# link speed UPnP advertises), ULA, SSH port and auth method, whether UPnP is
# enabled, any /mnt mount or container definition, dae's node config -- those
# are line-specific, security policy, or personal credentials.
#
# /etc/config/ as a whole is on sysupgrade's keep list, so after an upgrade the
# values already on the device are authoritative. This script re-runs on every
# flash and only fills in what is missing; it never overwrites.

set_if_unset() {
	[ -n "$(uci -q get "$1")" ] || uci set "$1=$2"
}

# --- flow offload ---------------------------------------------------------
# Software offload on, hardware offload explicitly off: the x86 NICs used here
# have no hardware flowtable, yet fw4 still writes flags offload and the kernel
# accepts it, so the switch reads as enabled while producing zero [HW_OFFLOAD]
# conntrack entries. Where it does work it bypasses the qdisc layer entirely,
# which defeats SQM.
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'

# --- two WAN->LAN openings that ship enabled ------------------------------
# Allow-IPSec-ESP and Allow-ISAKMP are stock OpenWrt rules forwarding ESP and
# udp/500 from WAN straight into LAN. Most home networks have no IPsec
# endpoint, so they are two free inbound paths. Re-enable in LuCI if needed.
for i in $(seq 0 20); do
	case "$(uci -q get firewall.@rule[$i].name)" in
		Allow-IPSec-ESP|Allow-ISAKMP) uci set firewall.@rule[$i].enabled='0' ;;
	esac
done

# --- packet steering ------------------------------------------------------
# Leave these unset and OpenWrt's packet_steering service takes its default
# branch: every NIC pinned to a single CPU and rps_flow_cnt written as 0, which
# silently disables RFS. 2 = spread over every CPU. XPS and flow limit are not
# its business; /usr/libexec/arm-xps-flowlimit owns those.
uci set network.globals.packet_steering='2'
set_if_unset network.globals.steering_flows '16384'

# --- qosify -------------------------------------------------------------
# Only line-independent structural parameters. Bandwidth stays empty and the
# service stays disabled -- a wrong rate pins the user to a wrong speed, so it
# has to be measured on site first.
#
# overhead_type must be manual: qosify's init reads the overhead field only
# inside the manual branch, so picking ethernet discards the byte count
# silently.
#
# 38 = 14 Ethernet header + 4 FCS + 8 preamble/SFD + 12 inter-frame gap, which
# is what cake's `ethernet` keyword covers; PPPoE adds 6 bytes of PPPoE header
# plus 2 of PPP protocol field = 46. Under PPPoE the qdisc sits on pppoe-wan
# where skb->len is already the IP length, so those 8 bytes are counted nowhere
# else and shaping at 38 keeps overshooting, moving the queue back to the
# upstream side. Hence the proto probe instead of a constant.
qos_oh=38
[ "$(uci -q get network.wan.proto)" = pppoe ] && qos_oh=46
if [ -n "$(uci -q get qosify.wan)" ]; then
	set_if_unset qosify.wan.disabled '1'
	uci set qosify.wan.overhead_type='manual'
	uci set qosify.wan.overhead="$qos_oh"
	uci set qosify.wan.overhead_mpu='84'
	set_if_unset qosify.wan.mode 'diffserv4'
	set_if_unset qosify.wan.nat '1'
	set_if_unset qosify.wan.host_isolate '1'
	set_if_unset qosify.wan.autorate_ingress '0'
fi

uci commit firewall
uci commit network
uci commit qosify 2>/dev/null

# --- timezone and time sync ---------------------------------------------
# The factory setting is UTC, which makes log timestamps disagree with the wall
# clock. Written only while still untouched.
case "$(uci -q get system.@system[0].timezone)" in
	''|UTC)
		uci set system.@system[0].timezone='CST-8'
		uci set system.@system[0].zonename='Asia/Shanghai'
		;;
esac

# The default *.openwrt.pool.ntp.org pool often takes tens of seconds to sync
# here, and DNSSEC, certificate validation and dae's cert chain all depend on a
# correct clock. Replace the whole set, but only while it is still the factory
# one.
if uci -q get system.ntp.server | grep -q 'openwrt\.pool\.ntp\.org'; then
	uci -q delete system.ntp.server
	for s in ntp.tencent.com ntp1.aliyun.com ntp.ntsc.ac.cn cn.ntp.org.cn; do
		uci add_list system.ntp.server="$s"
	done
fi
uci commit system

# --- LAN domain ---------------------------------------------------------
# Must match ub_main.domain in /etc/config/unbound, or the search domain odhcpd
# hands out and the suffix unbound builds local-data from disagree, and bare
# hostnames stop resolving. It is also what lets 94-unbound-private-tld negate
# lan. safely.
set_if_unset dhcp.lan.domain 'internal'

# leasefile is deliberately left in /tmp. odhcpd never restores its lease table
# from the file -- nothing in the source opens it for reading, dhcp_statefile
# appears only on write paths -- so moving it to /etc survives neither a reboot
# nor a sysupgrade and only costs one flash write per lease event. After a
# reboot LAN hostnames return to unbound as each device renews; static leases
# (config host) are the fix if they must be available immediately. The
# addresses themselves are stable regardless, assigned deterministically from
# the client identifier.
uci commit dhcp

# --- fullcone NAT -------------------------------------------------------
# ImmortalWrt-only. A real improvement for P2P, game consoles and NAT traversal
# generally, with no known side effect.
set_if_unset firewall.@defaults[0].fullcone '1'
uci commit firewall

# --- UPnP ---------------------------------------------------------------
# Stays disabled (the package's own upnpd.config ships enabled 0 and is not
# touched here): UPnP lets any LAN device open public ports on its own, which
# is real attack surface. The parameters below are configured so that ticking
# it on in LuCI is all that is needed, including this repo's miniupnpd NAT
# loopback patch (see after-installing-feed.sh) that lets LAN hosts reach a
# mapped port through the public address.
#
# ext_allow_private_ipv4: miniupnpd refuses to create any mapping while the
# external address is private or CGNAT (100.64/10), on the grounds that such a
# mapping is unreachable from the internet. An un-bridged ONT or a carrier
# handing out CGNAT addresses is common here, and without this option UPnP
# simply does nothing. It does not make ports reachable, it only stops the
# outright refusal. The package ships no such option, so set_if_unset enables
# it on a fresh config while leaving a manual disable intact.
#
# ipv6_disable: no IPv6 pinholes. A pinhole opens a publicly reachable IPv6
# entry straight to a LAN host, with none of the cover NAT gives IPv4 mappings.
#
# igdv1 is left alone: upstream sets 1 (force the IGDv1 description) for
# compatibility with older clients.
#
# download/upload are deleted: they shape nothing, they are only the link rates
# reported to clients in the IGD description so clients can plan against them.
# The shipped 1024/512 (Kbit/s) is wrong for any modern line and the correct
# value is line-specific, so report nothing and let clients treat it as unknown.
if [ -n "$(uci -q get upnpd.config)" ]; then
	set_if_unset upnpd.config.ext_allow_private_ipv4 '1'
	set_if_unset upnpd.config.ipv6_disable '1'
	uci -q delete upnpd.config.download
	uci -q delete upnpd.config.upload
	uci commit upnpd
fi

# --- dae ----------------------------------------------------------------
# Without /etc/dae/config.dae the service must not autostart: dae cannot come
# up without a config, procd restarts it in a loop, and the log floods with no
# visible root cause. The installer enables it after writing config.dae. This
# repo ships no dae config -- it holds node credentials.
if [ ! -s /etc/dae/config.dae ]; then
	[ -n "$(uci -q get dae.config)" ] && {
		uci set dae.config.enabled='0'
		uci commit dae
	}
	[ -x /etc/init.d/dae ] && /etc/init.d/dae disable
fi

# The luci-app-daede backend is dae, not daed. This must stay aligned with
# CONFIG_PACKAGE_luci-app-daede_dae in .config, or the kconfig choice pulls
# daed into the image as well (see CLAUDE.md).
[ -n "$(uci -q get daede.config)" ] && {
	set_if_unset daede.config.active_backend 'dae'
	uci commit daede
}

# --- podman-stack cron entries -------------------------------------------
# Idempotent append. /etc/crontabs is preserved by sysupgrade, so the copy on
# the device wins after an upgrade and this only fills in what is missing.
CRON=/etc/crontabs/root
[ -f "$CRON" ] || : > "$CRON"
if ! grep -q "podman-stack update" "$CRON" 2>/dev/null; then
	cat >> "$CRON" <<'CRONEOF'

# The definition directory /etc/podman-stack.d ships empty, so this entry does
# nothing until it is filled in.
20 4 * * * /usr/bin/podman-stack update >/dev/null 2>&1
# podman runs no health probes without systemd; without this the health column
# in `podman ps` is a frozen snapshot rather than a status. Restarts only
# containers that are running and unhealthy.
*/5 * * * * /usr/bin/podman-stack watchdog >/dev/null 2>&1
CRONEOF
	chmod 600 "$CRON"
fi

exit 0
